{
    "include": [
        "sdk/**/*",
        "src/**/*",
    ],
    "compilerOptions": {
        "target": "ES2022",
        "composite": true,
        "strict": true,
        "jsx": "react-jsx",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "rootDir": "./",
        "declarationMap": true,
        "declaration": true,
        "noEmit": false,
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ]
    },

}