{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "gen:sdk": {
            "outputs": [],
            "cache": false
        },
        "@boswaves-inc/smtp#gen:sdk": {
            "inputs": [
                "scripts/gen_sdk.ts",
                "src/routes/**/*.ts"
            ],
            "outputs": [
                "../sdk/src/schema.ts"
            ],
            "cache": false
        },
        "build": {
            "dependsOn": [
                "gen:sdk",
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**"
            ]
        },
        "dev": {
            "dependsOn": [
                "gen:sdk"
            ],
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "build"
            ]
        },
        "db:gen": {
            "cache": false
        },
        "db:mig": {
            "cache": false
        }
    }
}